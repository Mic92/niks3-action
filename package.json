{
  "name": "niks3-action",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node24 --format=cjs --define:NIKS3_VERSION=\\\"v$(cat NIKS3_VERSION)\\\" --outfile=dist/index.cjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/tool-cache": "^2.0.2"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "esbuild": "^0.25.0",
    "typescript": "^6.0.3"
  }
}
